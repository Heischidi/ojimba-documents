# =============================================================
# DIGITAL MARKETPLACE — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ----- Application -----
APP_URL=http://localhost:3000
ENVIRONMENT=development          # development | production

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace_password@localhost:5432/marketplace_db

# ----- JWT Authentication -----
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480           # 8 hours

# ----- Paystack -----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- AWS S3 -----
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=my-marketplace-files
S3_SIGNED_URL_EXPIRY=60         # seconds — short-lived download URLs

# ----- Resend (Email) -----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Digital Marketplace

# ----- File Upload -----
MAX_FILE_SIZE_MB=500             # maximum upload size in MB
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,zip,ppt,pptx,mp4,png,jpg,jpeg

# ----- Download Tokens -----
DOWNLOAD_TOKEN_EXPIRY_HOURS=48  # how long download links stay valid
MAX_DOWNLOADS=5                 # max downloads per token

# ----- CORS -----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Rate Limiting -----
RATE_LIMIT_LOGIN=5/minute        # max login attempts per IP per minute

# ----- Frontend (Next.js — must be prefixed NEXT_PUBLIC_) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_NAME=Digital Marketplace
